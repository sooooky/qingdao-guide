        const btn = document.getElementById(`nav-${t}`);
        if (btn) {
          if (t === tab) {
            btn.className = 'flex flex-col items-center py-1 px-2 rounded-xl text-amber-400 font-bold scale-105 transition';
          } else {
            btn.className = 'flex flex-col items-center py-1 px-2 rounded-xl text-slate-400 hover:text-slate-200 transition';
          }
        }
      });
      render();
    }

    function render() {
      const container = document.getElementById('tab-content');
      container.innerHTML = '';

      if (activeTab === 'itinerary') renderItinerary(container);
      else if (activeTab === 'map') renderMapView(container);
      else if (activeTab === 'calc') renderCalc(container);
      else if (activeTab === 'survival') renderSurvival(container);
      else if (activeTab === 'food') renderFood(container);
      else if (activeTab === 'checklist') renderChecklist(container);

      lucide.createIcons();
    }

    // --- TAB 1: ITINERARY ---
    function renderItinerary(container) {
      const dayItems = selectedDay === 'backup'
        ? backupPool
        : selectedDay === 'all'
          ? allItinerary
          : allItinerary.filter(i => i.day === selectedDay);

      container.innerHTML = `
        <div class="flex items-center justify-between bg-slate-900 p-1.5 rounded-2xl border border-slate-800">
          ${[1, 2, 3].map(d => `
            <button onclick="selectedDay=${d}; render();" class="flex-1 py-2 text-xs font-bold rounded-xl ${selectedDay === d ? 'bg-amber-500 text-slate-950 shadow-md' : 'text-slate-400'}">
              Day ${d}
            </button>
          `).join('')}
          <button onclick="selectedDay='all'; render();" class="px-3 py-2 text-xs font-bold rounded-xl ${selectedDay === 'all' ? 'bg-amber-500/20 text-amber-400' : 'text-slate-400'}">전체</button>
          <button onclick="selectedDay='backup'; render();" class="px-3 py-2 text-xs font-bold rounded-xl ${selectedDay === 'backup' ? 'bg-emerald-500/20 text-emerald-400' : 'text-slate-400'}">예비 (${backupPool.length})</button>
        </div>

        <div class="space-y-3">
          ${dayItems.map((item, idx) => `
            <div class="bg-slate-900 rounded-2xl p-4 border border-slate-800 space-y-2.5">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <span class="text-xs font-mono font-bold text-cyan-400 bg-slate-950 px-2 py-1 rounded-lg border border-slate-800">
                    ${item.startTime}
                  </span>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-800 text-slate-300">
                    Day ${item.day}
                  </span>
                </div>
                <div class="flex items-center space-x-1">
                  <button onclick="moveOrder('${item.id}', 'up')" class="p-1 text-slate-400"><i data-lucide="arrow-up" class="w-3.5 h-3.5"></i></button>
                  <button onclick="moveOrder('${item.id}', 'down')" class="p-1 text-slate-400"><i data-lucide="arrow-down" class="w-3.5 h-3.5"></i></button>
                  <button onclick="moveToBackupPool('${item.id}')" class="p-1 text-emerald-400"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                </div>
              </div>

              <div>
                <div class="flex items-baseline justify-between">
                  <h3 class="font-bold text-sm text-slate-100">${item.title}</h3>
                  <span class="text-xs font-bold text-amber-400">¥${item.estimatedCostCny}</span>
                </div>
                <p class="text-xs font-semibold text-amber-400/90 mt-0.5">${item.titleCn}</p>

                <!-- Editable Address Inputs -->
                <div class="mt-2 space-y-1.5 bg-slate-950/80 p-2.5 rounded-xl border border-slate-800">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-slate-400 font-semibold">📍 장소명 수동 수정:</span>
                    <input 
                      type="text" 
                      value="${item.titleCn}" 
                      onchange="updateItemField('${item.id}', 'titleCn', this.value)"
                      class="bg-slate-900 text-amber-400 font-bold px-2 py-0.5 rounded border border-slate-700 text-right w-36 focus:outline-none focus:border-amber-400"
                    />
                  </div>
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-slate-400 font-semibold">🏠 세부주소 수동 수정:</span>
                    <input 
                      type="text" 
                      value="${item.addressCn}" 
                      onchange="updateItemField('${item.id}', 'addressCn', this.value)"
                      class="bg-slate-900 text-slate-200 px-2 py-0.5 rounded border border-slate-700 text-right w-40 focus:outline-none focus:border-cyan-400 text-[10px]"
                    />
                  </div>
                </div>

                <p class="text-xs text-slate-300 mt-1.5">${item.desc}</p>
              </div>

              <!-- Map Deep Link Navigation Buttons -->
              <div class="flex items-center justify-between pt-2 border-t border-slate-800 gap-1.5">
                <button onclick="openAmap('${item.titleCn}', '${item.addressCn}')" class="flex-1 py-1.5 bg-cyan-950 hover:bg-cyan-900 text-cyan-300 border border-cyan-800 rounded-xl text-[11px] font-bold flex items-center justify-center gap-1">
                  <i data-lucide="compass" class="w-3 h-3"></i> 고덕지도 길찾기
                </button>
                <button onclick="openBaidu('${item.titleCn}', '${item.addressCn}')" class="flex-1 py-1.5 bg-blue-950 hover:bg-blue-900 text-blue-300 border border-blue-800 rounded-xl text-[11px] font-bold flex items-center justify-center gap-1">
                  <i data-lucide="map-pin" class="w-3 h-3"></i> 바이두 길찾기
                </button>
                <button onclick="openTaxiModal('${item.title}', '${item.addressCn}', '${item.pinyin}')" class="py-1.5 px-3 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-xl text-[11px] font-bold">
                  중국어 번역
                </button>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    // --- TAB 2: SMART MAP VIEW ---
    function renderMapView(container) {
      // 기존 맵 객체가 있다면 초기화
      if (leafletMap) {
        leafletMap.remove();
        leafletMap = null;
      }

      container.innerHTML = `
        <div class="space-y-3">
          <div class="flex items-center justify-between bg-slate-900 p-1.5 rounded-2xl border border-slate-800">
            ${[1, 2, 3].map(d => `
              <button onclick="selectedMapDay=${d}; initOrUpdateMap();" class="flex-1 py-2 text-xs font-bold rounded-xl ${selectedMapDay === d ? 'bg-amber-500 text-slate-950 shadow-md' : 'text-slate-400'}">
                Day ${d} 동선 지도
              </button>
            `).join('')}
          </div>

          <!-- Interactive Leaflet Map Box -->
          <div id="map-container" class="w-full h-80 min-h-[320px] bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-lg relative z-10"></div>

          <!-- Day Route Distance Summary -->
          <div id="map-route-summary" class="bg-slate-900 rounded-2xl p-4 border border-slate-800 space-y-2">
            <h3 class="text-xs font-bold text-amber-400 flex items-center gap-1">
              <i data-lucide="navigation" class="w-4 h-4"></i>
              <span>Day ${selectedMapDay} 주요 동선 및 거리 정보</span>
            </h3>
            <div id="route-list" class="space-y-1.5 text-xs text-slate-300"></div>
          </div>
        </div>
      `;

      // 탭 전환 시 지도가 깔끔하게 그려지도록 200ms 후 초기화 실행
      setTimeout(() => initOrUpdateMap(), 200);
    }

    function initOrUpdateMap() {
      const dayItems = allItinerary.filter(i => i.day === selectedMapDay);
      if (dayItems.length === 0) return;

      if (!leafletMap) {
        leafletMap = L.map('map-container').setView([dayItems[0].lat, dayItems[0].lng], 13);
        
        // Fastly 글로벌 CDN 및 CartoDB 오픈 타일 서버 (API Key / Referrer 차단 없는 타일)
        L.tileLayer('https://cartodb-basemaps-a.global.ssl.fastly.net/light_all/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap & &copy; CARTO'
        }).addTo(leafletMap);

        // 지도가 활성화될 때 레이아웃 컨테이너 재계산 (회색 화면 방지)
        setTimeout(() => {
          if (leafletMap) leafletMap.invalidateSize();
        }, 300);
      } else {
        setTimeout(() => {
          if (leafletMap) leafletMap.invalidateSize();
        }, 150);
      }

      // Clear existing markers & polyline
      mapMarkers.forEach(m => leafletMap.removeLayer(m));
      mapMarkers = [];
      if (mapPolyline) leafletMap.removeLayer(mapPolyline);

      const latLngs = [];
      const routeListHtml = [];

      dayItems.forEach((item, idx) => {
        if (!item.lat || !item.lng) return;

        const pos = [item.lat, item.lng];
        latLngs.push(pos);

        // Sequence Numbered Marker
        const customIcon = L.divIcon({
          className: 'custom-map-marker',
          html: `<span>${idx + 1}</span>`,
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        });

        const marker = L.marker(pos, { icon: customIcon }).addTo(leafletMap);
        marker.bindPopup(`
          <div class="text-slate-100 p-1 space-y-2">
            <div class="font-black text-sm text-amber-400">${idx + 1}. ${item.title}</div>
            <div class="text-xs text-slate-300">${item.addressCn}</div>
            <div class="text-[11px] text-cyan-400 font-bold">⏰ ${item.startTime} (${item.durationMinutes}분 체류)</div>
            <div class="flex gap-1 pt-1">
              <button onclick="openAmap('${item.titleCn}', '${item.addressCn}')" class="flex-1 py-1 bg-cyan-600 text-white text-[10px] rounded font-bold">고덕 길찾기</button>
              <button onclick="openTaxiModal('${item.title}', '${item.addressCn}', '${item.pinyin}')" class="flex-1 py-1 bg-amber-500 text-slate-950 text-[10px] rounded font-bold">번역 카드</button>
            </div>
          </div>
        `);
        mapMarkers.push(marker);

        // Distance Calculation between consecutive items
        if (idx > 0) {
          const prev = dayItems[idx - 1];
          const dist = calculateDistanceKm(prev.lat, prev.lng, item.lat, item.lng);
          routeListHtml.push(`
            <div class="flex items-center justify-between p-2 bg-slate-950 rounded-xl border border-slate-800">
              <span>${prev.title} ➔ ${item.title}</span>
              <span class="font-mono font-bold text-cyan-400">약 ${dist} km</span>
            </div>
          `);
        }
      });

      // Draw Polyline Route Line
      if (latLngs.length > 1) {
        mapPolyline = L.polyline(latLngs, { color: '#f59e0b', weight: 4, opacity: 0.8, dashArray: '6, 8' }).addTo(leafletMap);
        leafletMap.fitBounds(mapPolyline.getBounds(), { padding: [30, 30] });
      } else if (latLngs.length === 1) {
        leafletMap.setView(latLngs[0], 14);
      }

      document.getElementById('route-list').innerHTML = routeListHtml.length > 0
        ? routeListHtml.join('')
        : '<p class="text-slate-500 text-xs">등록된 이동 경로가 없습니다.</p>';
    }

    // --- TAB 3: CURRENCY & EXPENSES ---
    function renderCalc(container) {
      container.innerHTML = `
        <div class="bg-slate-900 rounded-2xl p-4 border border-slate-800 space-y-3">
          <h2 class="font-bold text-slate-100 text-sm">실시간 환율 계산기 (1元 = ${exchangeRate}원)</h2>
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
              <span class="text-[10px] text-slate-400">중국 위안 (CNY ¥)</span>
              <input type="number" id="cny-in" oninput="convertCny(this.value)" placeholder="0" class="w-full bg-transparent text-lg font-black text-amber-400 focus:outline-none" />
            </div>
            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
              <span class="text-[10px] text-slate-400">한국 원화 (KRW ₩)</span>
              <input type="number" id="krw-in" readonly placeholder="0" class="w-full bg-transparent text-lg font-black text-cyan-400 focus:outline-none" />
            </div>
          </div>
        </div>
      `;
    }
    function convertCny(val) {
      const num = parseFloat(val) || 0;
      document.getElementById('krw-in').value = Math.round(num * exchangeRate);
    }

    // --- TAB 4: SURVIVAL / TRANSPORT CARDS ---
    function renderSurvival(container) {
      container.innerHTML = `
        <div class="bg-slate-900 rounded-2xl p-4 border border-slate-800 space-y-3">
          <h2 class="font-bold text-slate-100 text-sm">택시 기사님 중국어 번역 카드리스트</h2>
          <div class="space-y-2">
            ${TAXI_CARDS.map(c => `
              <div onclick="openTaxiModal('${c.title}', '${c.cn}', '${c.pinyin}')" class="p-3 bg-slate-950 rounded-xl border border-slate-800 hover:border-amber-400/60 cursor-pointer flex justify-between items-center">
                <div>
                  <div class="text-xs font-bold text-slate-200">${c.title}</div>
                  <div class="text-sm font-black text-amber-400 mt-1">${c.cn}</div>
                </div>
                <span class="text-xs px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-300 font-semibold">번역 보기</span>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    // --- TAB 5: FOOD GUIDE ---
    function renderFood(container) {
      container.innerHTML = `
        <div class="bg-slate-900 rounded-2xl p-4 border border-slate-800 space-y-3">
          <h2 class="font-bold text-amber-400 text-sm">🍺 칭다오 원장 생맥주 & 먹거리 가이드</h2>
          <p class="text-xs text-slate-300">유통기한 7일 원장 맥주(原浆)와 바지락 볶음(辣炒嘎啦) 조합 필수!</p>
        </div>
      `;
    }

    // --- TAB 6: CHECKLIST ---
    function renderChecklist(container) {
      container.innerHTML = `
        <div class="bg-slate-900 rounded-2xl p-4 border border-slate-800 space-y-3">
          <h2 class="font-bold text-slate-100 text-sm">여행 준비물 체크리스트</h2>
          <div class="space-y-2">
            ${checklist.map(c => `
              <div onclick="toggleCheck('${c.id}')" class="p-3 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between cursor-pointer">
                <span class="text-xs ${c.checked ? 'line-through text-slate-500' : 'text-slate-200'}">${c.text}</span>
                <i data-lucide="${c.checked ? 'check-circle' : 'circle'}" class="w-4 h-4 ${c.checked ? 'text-emerald-400' : 'text-slate-600'}"></i>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    function toggleCheck(id) {
      checklist = checklist.map(c => c.id === id ? { ...c, checked: !c.checked } : c);
      saveAllData();
      render();
    }

    function updateItemField(id, field, value) {
      allItinerary = allItinerary.map(i => i.id === id ? { ...i, [field]: value.trim() } : i);
      saveAllData();
      showToast('장소 및 주소가 수정되었습니다!');
    }

    function moveOrder(id, dir) {
      const idx = allItinerary.findIndex(i => i.id === id);
      if (idx === -1) return;
      if (dir === 'up' && idx > 0) {
        const temp = allItinerary[idx];
        allItinerary[idx] = allItinerary[idx - 1];
        allItinerary[idx - 1] = temp;
      } else if (dir === 'down' && idx < allItinerary.length - 1) {
        const temp = allItinerary[idx];
        allItinerary[idx] = allItinerary[idx + 1];
        allItinerary[idx + 1] = temp;
      }
      saveAllData();
      render();
    }

    function moveToBackupPool(id) {
      const item = allItinerary.find(i => i.id === id);
      if (!item) return;
      allItinerary = allItinerary.filter(i => i.id !== id);
      backupPool.unshift(item);
      saveAllData();
      showToast(`"${item.title}" 일정이 예비목록으로 이동되었습니다.`);
      render();
    }

    function openTaxiModal(title, addressCn, pinyin) {
      const overlay = document.getElementById('modal-overlay');
      const body = document.getElementById('modal-body');
      body.innerHTML = `
        <div class="text-center space-y-4">
          <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold">🚕 기사님께 스크린을 보여주세요</span>
          <div class="py-3 space-y-2">
            <h3 class="text-slate-300 text-sm font-semibold">${title}</h3>
            <p class="text-2xl font-black text-amber-400 leading-snug">${addressCn}</p>
            <p class="text-xs text-slate-400">${pinyin || ''}</p>
          </div>

          <!-- 중국어 발음 읽어주기 TTS 버튼 -->
          <button onclick="speakChinese('${addressCn.replace(/'/g, "\\'")}')" class="w-full py-2.5 bg-cyan-950 hover:bg-cyan-900 text-cyan-300 border border-cyan-700/80 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
            <i data-lucide="volume-2" class="w-4 h-4"></i>
            <span>🔊 중국어 음성 재생 (스피커)</span>
          </button>

          <button onclick="closeModal()" class="w-full py-2.5 bg-amber-500 text-slate-950 font-bold text-xs rounded-xl">닫기</button>
        </div>
      `;
      overlay.classList.remove('hidden');
      lucide.createIcons();
    }

    function closeModal() {
      document.getElementById('modal-overlay').classList.add('hidden');
    }

    function openBackupModal() {
      const overlay = document.getElementById('modal-overlay');
      const body = document.getElementById('modal-body');
      body.innerHTML = `
        <div class="space-y-4">
          <h3 class="text-sm font-bold text-slate-100">일정 백업 및 복원</h3>
          <button onclick="downloadJSON()" class="w-full py-2.5 bg-cyan-600 text-white text-xs font-bold rounded-xl">JSON 파일 내보내기</button>
          <button onclick="closeModal()" class="w-full py-2 bg-slate-800 text-slate-300 text-xs rounded-xl">닫기</button>
        </div>
      `;
      overlay.classList.remove('hidden');
    }

    function downloadJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({ allItinerary, backupPool, expenses, checklist }));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `qingdao_plan.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function resetData() {
      if (confirm('모든 변경사항을 초기화하시겠습니까?')) {
        localStorage.clear();
        location.reload();
      }
    }

    // App Initialization
    window.onload = function() {
      render();
    };
  </script>
</body>
</html>